      // تحقق من أن الإنجاز جديد (خلال آخر دقيقة)
      const achievedDate = new Date(a.achieved_at || a.grantedAt);
      const now = new Date();
      const diffMinutes = (now - achievedDate) / (1000 * 60);
      return diffMinutes < 1;
    });

    if (newAchievement) {
