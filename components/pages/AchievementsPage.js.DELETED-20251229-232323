'use client';

import { useState, useEffect } from 'react';
import { useRouter } from 'next/navigation';
import { 
  TrendingUp, 
  Users, 
  Star,
  Heart,
  Trophy,
  BarChart3,
  Zap,
  Crown,
  ArrowRight
} from 'lucide-react';

export default function AchievementsPage() {
  const router = useRouter();
  const [stats, setStats] = useState(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);

  useEffect(() => {
    fetchData();
  }, []);

  const fetchData = async () => {
    try {
      setLoading(true);
      setError(null);

      // ✅ فقط /api/stats (بدون profile)
      const statsResponse = await fetch('/api/stats', {
        credentials: 'include'
      });

      if (statsResponse.ok) {
        const statsData = await statsResponse.json();
        if (statsData.success) {
          setStats(statsData.stats);
        }
      }

    } catch (err) {
      console.error('خطأ في جلب البيانات:', err);
      setError(err.message);
    } finally {
      setLoading(false);
    }
  };

  if (loading) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50">
        <div className="text-center">
          <div className="animate-spin rounded-full h-16 w-16 border-b-2 border-purple-600 mx-auto mb-4"></div>
          <p className="text-gray-600">جارٍ تحميل الإنجازات...</p>
        </div>
      </div>
    );
  }

  if (error) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50">
        <div className="bg-white p-8 rounded-2xl shadow-xl text-center max-w-md">
          <div className="text-red-500 text-5xl mb-4">⚠️</div>
          <h2 className="text-xl font-bold text-gray-800 mb-2">حدث خطأ</h2>
          <p className="text-gray-600 mb-4">{error}</p>
          <div className="flex gap-3 justify-center">
            <button
              onClick={fetchData}
              className="px-6 py-2 bg-purple-600 text-white rounded-lg hover:bg-purple-700 transition-colors"
            >
              إعادة المحاولة
            </button>
            <button
              onClick={() => router.push('/')}
              className="px-6 py-2 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 transition-colors"
            >
              رجوع
            </button>
          </div>
        </div>
      </div>
    );
  }

  if (!stats) {
    return (
      <div className="min-h-screen flex items-center justify-center bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50">
        <div className="text-center text-gray-600">
          لا توجد إحصائيات متاحة
        </div>
      </div>
    );
  }

  // البيانات من stats فقط
  const totalPrayers = stats.totalPrayersGiven || 0;
  const currentStars = stats.totalStars || 0;
  const dailyStreak = stats.userLevel?.dailyStreak || 0;
  const userLevel = stats.userLevel?.level || 1;
  
  // حساب النجمة القادمة
  const nextStarAt = (currentStars + 1) * 20;
  const prayersToNextStar = Math.max(0, nextStarAt - totalPrayers);
  const progressToNextStar = totalPrayers >= nextStarAt ? 100 : ((totalPrayers % 20) / 20) * 100;

  // البيانات العامة
  const believersCount = stats.believersCount || 0;
  const todayPrayersCount = stats.todayPrayersCount || 0;
  const activeRequestsCount = stats.activeRequestsCount || 0;
  const todayActiveUsers = stats.todayActiveUsers || [];
  const prayersReceivedCount = stats.prayersReceivedCount || 0;

  return (
    <div className="min-h-screen bg-gradient-to-br from-blue-50 via-purple-50 to-pink-50 py-8 px-4">
      <div className="max-w-7xl mx-auto">
        
        {/* زر الرجوع + العنوان */}
        <div className="mb-8">
          <button
            onClick={() => router.push('/')}
            className="flex items-center gap-2 text-gray-600 hover:text-gray-800 mb-4 transition-colors group"
          >
            <ArrowRight className="w-5 h-5 group-hover:translate-x-1 transition-transform" />
            <span>رجوع</span>
          </button>

          <div className="text-center">
            <h1 className="text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-purple-600 to-pink-600 mb-2">
              🏆 الإنجازات
            </h1>
            <p className="text-gray-600">
              نظرة شاملة على الإنجازات في المنصة
            </p>
          </div>
        </div>

        {/* نظرة سريعة */}
        <div className="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
          <QuickStatCard
            icon={<Heart className="w-6 h-6" />}
            label="إجمالي الدعوات"
            value={totalPrayers}
            color="rose"
          />
          <QuickStatCard
            icon={<Star className="w-6 h-6" />}
            label="النجوم"
            value={currentStars}
            color="amber"
          />
          <QuickStatCard
            icon={<Zap className="w-6 h-6" />}
            label="Streak"
            value={`${dailyStreak} يوم`}
            color="orange"
          />
          <QuickStatCard
            icon={<Trophy className="w-6 h-6" />}
            label="المستوى"
            value={`Level ${userLevel}`}
            color="purple"
          />
        </div>

        {/* النجوم */}
        <div className="bg-white rounded-2xl shadow-xl p-6 mb-8 border-2 border-amber-200">
          <div className="flex items-center gap-3 mb-6">
            <Star className="w-7 h-7 text-amber-500" />
            <h2 className="text-2xl font-bold text-gray-800">النجوم</h2>
          </div>

          <div className="space-y-6">
            <div className="text-center py-6 bg-gradient-to-r from-amber-50 to-yellow-50 rounded-xl">
              <div className="text-5xl mb-3">
                {currentStars > 0 ? '⭐'.repeat(currentStars) : '🌟'}
              </div>
              <p className="text-2xl font-bold text-amber-700">
                {currentStars} {currentStars === 1 ? 'نجمة' : currentStars === 2 ? 'نجمتان' : 'نجوم'}
              </p>
              <p className="text-sm text-amber-600 mt-1">
                كل 20 دعاء = نجمة جديدة ⭐
              </p>
            </div>

            <div>
              <div className="flex justify-between items-center mb-2">
                <span className="text-sm font-semibold text-gray-700">
                  🎯 النجمة القادمة
                </span>
                <span className="text-sm font-bold text-amber-600">
                  {prayersToNextStar} دعاء متبقي
                </span>
              </div>
              <div className="w-full bg-gray-200 rounded-full h-4 overflow-hidden">
                <div
                  className="h-full bg-gradient-to-r from-amber-400 to-yellow-500 transition-all duration-500 flex items-center justify-end"
                  style={{ width: `${progressToNextStar}%` }}
                >
                  {progressToNextStar > 10 && (
                    <span className="text-xs font-bold text-white pr-2">
                      {Math.round(progressToNextStar)}%
                    </span>
                  )}
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* المتصدرون */}
        {todayActiveUsers && todayActiveUsers.length > 0 && (
          <div className="bg-white rounded-2xl shadow-xl p-6 mb-8">
            <div className="flex items-center gap-3 mb-6">
              <Crown className="w-7 h-7 text-yellow-500" />
              <h2 className="text-2xl font-bold text-gray-800">المتصدرون اليوم</h2>
            </div>

            <div className="space-y-3">
              {todayActiveUsers.slice(0, 5).map((user, index) => (
                <div
                  key={user.id}
                  className={`flex items-center gap-4 p-4 rounded-xl transition-all ${
                    index === 0
                      ? 'bg-gradient-to-r from-yellow-100 to-amber-100 border-2 border-yellow-300'
                      : index === 1
                      ? 'bg-gradient-to-r from-gray-100 to-slate-100 border-2 border-gray-300'
                      : index === 2
                      ? 'bg-gradient-to-r from-orange-100 to-amber-100 border-2 border-orange-300'
                      : 'bg-gray-50'
                  }`}
                >
                  <div className="text-2xl">
                    {index === 0 ? '🥇' : index === 1 ? '🥈' : index === 2 ? '🥉' : '⭐'}
                  </div>
                  <div className="flex-1">
                    <p className="font-bold text-gray-800">{user.name}</p>
                    <p className="text-sm text-gray-600">{user.prayerCount} دعاء</p>
                  </div>
                  {user.level >= 2 && (
                    <div className="text-blue-500">🔵</div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* إحصائيات المنصة */}
        <div className="bg-white rounded-2xl shadow-xl p-6">
          <div className="flex items-center gap-3 mb-6">
            <TrendingUp className="w-7 h-7 text-green-500" />
            <h2 className="text-2xl font-bold text-gray-800">إحصائيات المنصة</h2>
          </div>

          <div className="grid grid-cols-2 md:grid-cols-3 gap-4">
            <PlatformStatCard
              label="المؤمنون"
              value={believersCount}
              icon="👥"
            />
            <PlatformStatCard
              label="دعوات اليوم"
              value={todayPrayersCount}
              icon="📿"
            />
            <PlatformStatCard
              label="الطلبات النشطة"
              value={activeRequestsCount}
              icon="💬"
            />
          </div>

          <div className="mt-6 text-center p-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl">
            <p className="text-gray-700">
              🌟 مجتمع نشط من <span className="font-bold text-green-700">{believersCount}</span> مؤمن
            </p>
          </div>
        </div>

      </div>
    </div>
  );
}

// Components

function QuickStatCard({ icon, label, value, color }) {
  const colorClasses = {
    rose: 'from-rose-500 to-pink-500',
    amber: 'from-amber-500 to-yellow-500',
    orange: 'from-orange-500 to-red-500',
    purple: 'from-purple-500 to-pink-500',
    blue: 'from-blue-500 to-cyan-500',
    green: 'from-green-500 to-emerald-500'
  };

  return (
    <div className="bg-white rounded-xl shadow-lg p-4 border-2 border-gray-100 hover:border-gray-200 transition-all">
      <div className={`inline-flex p-2 rounded-lg bg-gradient-to-r ${colorClasses[color]} text-white mb-2`}>
        {icon}
      </div>
      <p className="text-2xl font-bold text-gray-800">{value}</p>
      <p className="text-sm text-gray-600">{label}</p>
    </div>
  );
}

function PlatformStatCard({ label, value, icon }) {
  return (
    <div className="p-4 bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl text-center">
      <div className="text-3xl mb-2">{icon}</div>
      <p className="text-2xl font-bold text-gray-800">{value}</p>
      <p className="text-sm text-gray-600">{label}</p>
    </div>
  );
}
